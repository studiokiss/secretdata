# Credentials pour accéder à /create
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=changeme

# JWT Secret pour les sessions (min 32 caractères)
JWT_SECRET=changeme-generate-a-random-base64-string

# Redis URL pour rate limiting persistant (optionnel)
# Sans Redis, le rate limiting est en mémoire (reset au redémarrage)
# REDIS_URL=redis://localhost:6379

# Optionnel
# SITE_NAME=Secret Data
# SITE_DOMAIN=example.com
# APP_PORT=3000
